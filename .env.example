# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# NEVER commit the real .env — it holds live credentials.

# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token_here

# --- Instagram ---
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Get yours by sending /whoami to the bot. Leave empty to allow anyone.
ALLOWED_TELEGRAM_IDS=

# --- Optional AI captions (only used if caption.txt is empty) ---
ANTHROPIC_API_KEY=
CAPTION_MODEL=claude-opus-4-8

# --- Cloud/session (optional) ---
# Base64 of a session created at home, for datacenter hosts. See make_session_b64.py
IG_SESSION_B64=
